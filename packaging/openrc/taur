#!/sbin/openrc-run
# Settings: /etc/taur/taur.env (TAUR_* variables), loaded below.

name="taur"
description="TAUR AUR-compatible package server"
command="/usr/bin/taur"
command_args="serve"
command_user="taur:taur"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/taur.log"
error_log="/var/log/taur.log"

depend() {
    need net
    after firewall
}

start_pre() {
    export TAUR_HOME=/var/lib/taur
    if [ -r /etc/taur/taur.env ]; then
        set -a
        . /etc/taur/taur.env
        set +a
    fi
    checkpath --directory --owner taur:taur --mode 0750 "$TAUR_HOME"
    checkpath --file --owner taur:taur --mode 0640 /var/log/taur.log
}
