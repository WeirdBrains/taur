<!-- WinSW v2/v3 service definition for TAUR (https://github.com/winsw/winsw).
     install-service.ps1 generates the real taur.xml from this template plus taur.env;
     each TAUR_* variable from the env file becomes an <env> entry. -->
<service>
  <id>taur</id>
  <name>TAUR package server</name>
  <description>TAUR AUR-compatible package server (taur serve).</description>
  <executable>C:\Program Files\TAUR\taur.exe</executable>
  <arguments>serve</arguments>
  <workingdirectory>C:\ProgramData\TAUR</workingdirectory>
  <env name="TAUR_HOME" value="C:\ProgramData\TAUR\data"/>
  <!--ENV-->
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <logpath>C:\ProgramData\TAUR\logs</logpath>
  <onfailure action="restart" delay="5 sec"/>
  <startmode>Automatic</startmode>
  <stoptimeout>15 sec</stoptimeout>
</service>
