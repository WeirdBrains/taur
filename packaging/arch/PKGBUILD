# Maintainer: WeirdBrains <taur@weirdbrains.com>
# scripts/package.sh copies this file, sets pkgver and the payload checksum,
# and writes payload.tar.gz beside it. package() does not compile Rust.
pkgname=taur
pkgver=1.3.1
pkgrel=1
pkgdesc='AUR-compatible package server'
arch=('x86_64')
url='https://github.com/WeirdBrains/taur'
license=('MIT' 'Apache-2.0')
depends=('git' 'systemd')
backup=('etc/taur/taur.env')
options=('!strip' '!debug' '!lto')
install=taur.install
source=(payload.tar.gz)
sha256sums=('SKIP')

package() {
  cp -a "${srcdir}/." "${pkgdir}/"
  rm -f "${pkgdir}/payload.tar.gz"
  chown -R root:root "${pkgdir}"
  chmod 0750 "${pkgdir}/etc/taur"
  chmod 0640 "${pkgdir}/etc/taur/taur.env"
}
