# Maintainer: WeirdBrains <taur@weirdbrains.com>
# scripts/release.sh sets pkgver to the workspace version and regenerates
# .SRCINFO with makepkg --printsrcinfo. scripts/package.sh copies this file,
# sets pkgver and the payload checksum, writes payload.tar.gz beside it, and
# rewrites .SRCINFO in the build directory. package() does not compile Rust.
# .SRCINFO is source-recipe metadata; it is not installed as a runtime file.
pkgname=taur
pkgver=1.5.0
pkgrel=1
pkgdesc='AUR-compatible package server'
arch=('x86_64')
url='https://github.com/WeirdBrains/taur'
license=('MIT' 'Apache-2.0')
depends=('git' 'systemd')
backup=('etc/taur/taur.env')
options=('!strip' '!debug' '!lto')
install=taur.install
source=(payload.tar.gz)
sha256sums=('SKIP')

package() {
  cp -a "${srcdir}/." "${pkgdir}/"
  rm -f "${pkgdir}/payload.tar.gz"
  chown -R root:root "${pkgdir}"
  chmod 0750 "${pkgdir}/etc/taur"
  chmod 0640 "${pkgdir}/etc/taur/taur.env"
}
