[Unit]
Description=TAUR AUR-compatible package server
Documentation=https://github.com/WeirdBrains/taur/blob/main/docs/services.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taur
Group=taur
# Settings (TAUR_BIND, TAUR_BASE_URL, TAUR_SMTP_URL, ...) come from the env file.
Environment=TAUR_HOME=/var/lib/taur
EnvironmentFile=/etc/taur/taur.env
ExecStart=/usr/bin/taur serve
Restart=on-failure
RestartSec=5s
StateDirectory=taur
StateDirectoryMode=0750
UMask=0027

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# To bind a port below 1024 (e.g. SSH on 22), uncomment:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
