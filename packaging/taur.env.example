# Minimal production settings for `taur serve` (systemd EnvironmentFile=). Every
# variable with a description is in ../.env.example and docs/configuration.md.

TAUR_HOME=/var/lib/taur
# SQLite database. Unset uses $TAUR_HOME/taur.db. The parent directory must already exist.
#TAUR_DB=/var/lib/taur/taur.db
# Plaintext behind a proxy. For automatic HTTPS see docs/tls.md (TAUR_TLS, TAUR_DOMAIN,
# TAUR_ACME_DIRECTORY, TAUR_ACME_STAGING, TAUR_ACME_CONTACT, TAUR_ACME_ACCEPT_TERMS,
# TAUR_ACME_HTTP_BIND, TAUR_ACME_CACHE, TAUR_ACME_RENEW_BEFORE).
TAUR_TLS=off
TAUR_BIND=127.0.0.1:8080
# Example package host. Not a default and not a certificate request.
TAUR_DOMAIN=packages.taur.weirdbrains.com
TAUR_BASE_URL=https://packages.taur.weirdbrains.com

# Git over SSH (comment out to disable). Public host/port shown in clone URLs:
TAUR_SSH_BIND=0.0.0.0:2222
#TAUR_SSH_PUBLIC_HOST=packages.taur.weirdbrains.com
#TAUR_SSH_PUBLIC_PORT=2222

# gRPC (comment out to disable); plaintext, proxy TLS in front if public.
#TAUR_GRPC_BIND=127.0.0.1:50051

# Mail. Without TAUR_SMTP_URL, mail is written to $TAUR_HOME/outbox.
#TAUR_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
TAUR_MAIL_FROM="TAUR <noreply@taur.weirdbrains.com>"

# Site admins granted at startup (grant only; revoke with `taur admin NAME --revoke`).
#TAUR_ADMINS=alice,bob
# Site owners granted at startup (also grants admin; revoke with `taur owner NAME --revoke`).
# When either variable is set, the first registration is not promoted.
#TAUR_OWNERS=alice

# Defaults are already on. 0 disables a class. Set TAUR_TRUSTED_PROXIES to the proxy
# CIDR if this process should read X-Forwarded-For. Also: TAUR_AUTH_RATE_LIMIT,
# TAUR_AUTH_RATE_WINDOW, TAUR_GIT_RATE_LIMIT, TAUR_GIT_RATE_WINDOW, TAUR_API_RATE_LIMIT,
# TAUR_API_RATE_WINDOW, TAUR_DUMP_RATE_LIMIT, TAUR_DUMP_RATE_WINDOW, TAUR_MCP_RATE_LIMIT,
# TAUR_MCP_RATE_WINDOW, TAUR_GRPC_RATE_LIMIT, TAUR_GRPC_RATE_WINDOW, TAUR_SSH_RATE_LIMIT,
# TAUR_SSH_RATE_WINDOW, TAUR_RATE_MAX_KEYS.
# Web UI page views are counted by default (docs/metrics.md); set false to stop.
#TAUR_PAGE_VIEWS=false
#TAUR_RPC_RATE_LIMIT=300
#TAUR_RPC_RATE_WINDOW=60
#TAUR_TRUSTED_PROXIES=10.0.0.0/8
