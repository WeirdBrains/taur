# Minimal production settings for `taur serve` (systemd EnvironmentFile=). Every
# variable with a description is in ../.env.example and docs/configuration.md.

TAUR_HOME=/var/lib/taur
# HTTP; put a TLS reverse proxy in front.
TAUR_BIND=127.0.0.1:8080
TAUR_BASE_URL=https://packages.taur.weirdbrains.com

# Git over SSH (comment out to disable). Public host/port shown in clone URLs:
TAUR_SSH_BIND=0.0.0.0:2222
#TAUR_SSH_PUBLIC_HOST=packages.taur.weirdbrains.com
#TAUR_SSH_PUBLIC_PORT=2222

# gRPC (comment out to disable); plaintext, proxy TLS in front if public.
#TAUR_GRPC_BIND=127.0.0.1:50051

# Mail. Without TAUR_SMTP_URL, mail is written to $TAUR_HOME/outbox.
#TAUR_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
TAUR_MAIL_FROM="TAUR <noreply@taur.weirdbrains.com>"

# Site admins granted at startup (grant only; revoke with `taur admin NAME --revoke`).
#TAUR_ADMINS=alice,bob

# RPC rate limit per TCP peer (0 disables). Forwarded IP headers are not trusted.
#TAUR_RPC_RATE_LIMIT=400
#TAUR_RPC_RATE_WINDOW=60
