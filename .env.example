# Example environment for TAUR. Copy to .env (git-ignored) and adjust; TAUR does not
# load .env itself, so source it (`set -a; . ./.env; set +a`) or use it as a systemd
# EnvironmentFile=. Command-line flags override these. All credentials are placeholders.
# See docs/configuration.md. packaging/taur.env.example is a minimal production variant.

# ---- taur serve ----
# Data directory: database, git repos, mail outbox, SSH host key.
TAUR_HOME=/var/lib/taur
# Listen address. Plaintext HTTP while TAUR_TLS=off; HTTPS when TAUR_TLS=acme.
TAUR_BIND=127.0.0.1:8080
# off (local HTTP or a TLS proxy) or acme (automatic HTTPS). Never inferred.
TAUR_TLS=off
# DNS names for the certificate and the default public host. Required for acme.
# Example only; not requested by this repository.
TAUR_DOMAIN=packages.example.com
# Public URL. Empty: derived from TAUR_DOMAIN or the listen address.
TAUR_BASE_URL=https://packages.example.com
# ACME directory. Empty uses Let's Encrypt production, or staging when TAUR_ACME_STAGING=true.
TAUR_ACME_DIRECTORY=
TAUR_ACME_STAGING=false
# mailto: contact. Required before acme will start. No default address.
TAUR_ACME_CONTACT=
# Must be the word yes after you read the CA agreement. Empty refuses to register.
TAUR_ACME_ACCEPT_TERMS=
# Socket that receives HTTP-01 on port 80 of each domain. Required for acme.
TAUR_ACME_HTTP_BIND=
# Account key and certificates. Empty uses $TAUR_HOME/acme.
TAUR_ACME_CACHE=
# Days before expiry to renew.
TAUR_ACME_RENEW_BEFORE=30
# Git-over-SSH listen address; remove to disable SSH.
TAUR_SSH_BIND=0.0.0.0:2222
# Host and port shown in SSH clone URLs (defaults: base URL host, SSH bind port).
TAUR_SSH_PUBLIC_HOST=packages.taur.weirdbrains.com
TAUR_SSH_PUBLIC_PORT=2222
# gRPC listen address. Plaintext HTTP/2 while TAUR_TLS=off; the HTTPS certificate when acme.
TAUR_GRPC_BIND=127.0.0.1:50051
# SMTP server (secret). Remove to write mail to $TAUR_HOME/outbox instead.
TAUR_SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender address for outgoing mail.
TAUR_MAIL_FROM="TAUR <noreply@taur.weirdbrains.com>"
# Comma-separated users granted site admin at startup (grant only, never revokes).
TAUR_ADMINS=alice,bob
# Per-client limits. 0 disables that class. X-Forwarded-For is ignored unless the
# TCP peer is listed in TAUR_TRUSTED_PROXIES.
TAUR_RPC_RATE_LIMIT=300
TAUR_RPC_RATE_WINDOW=60
TAUR_AUTH_RATE_LIMIT=20
TAUR_AUTH_RATE_WINDOW=60
TAUR_GIT_RATE_LIMIT=60
TAUR_GIT_RATE_WINDOW=60
TAUR_API_RATE_LIMIT=120
TAUR_API_RATE_WINDOW=60
TAUR_DUMP_RATE_LIMIT=12
TAUR_DUMP_RATE_WINDOW=60
TAUR_MCP_RATE_LIMIT=60
TAUR_MCP_RATE_WINDOW=60
TAUR_GRPC_RATE_LIMIT=300
TAUR_GRPC_RATE_WINDOW=60
TAUR_SSH_RATE_LIMIT=30
TAUR_SSH_RATE_WINDOW=60
TAUR_TRUSTED_PROXIES=
TAUR_RATE_MAX_KEYS=8192

# ---- taurctl ----
# Server URL (overrides the config file).
TAUR_SERVER=https://packages.example.com
# Config directory holding settings and the session token.
TAURCTL_CONFIG_DIR=/home/alice/.config/taurctl

# ---- development only ----
# Set to 1 when running tests to regenerate man pages in man/.
#TAUR_UPDATE_MAN=1
# Internal (set by the server for git hooks; never set by hand):
# TAUR_HOOK_BIN, TAUR_PUSHER.
