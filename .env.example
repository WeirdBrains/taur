# Example environment for TAUR. Copy to .env (git-ignored) and adjust; TAUR does not
# load .env itself, so source it (`set -a; . ./.env; set +a`) or use it as a systemd
# EnvironmentFile=. Command-line flags override these. All credentials are placeholders.
# See docs/configuration.md. packaging/taur.env.example is a minimal production variant.

# ---- taur serve ----
# Data directory: database, git repos, mail outbox, SSH host key.
TAUR_HOME=/var/lib/taur
# HTTP listen address (IP:PORT); put a TLS reverse proxy in front.
TAUR_BIND=127.0.0.1:8080
# Public URL used in email links and clone URLs (no path).
TAUR_BASE_URL=https://packages.taur.weirdbrains.com
# Git-over-SSH listen address; remove to disable SSH.
TAUR_SSH_BIND=0.0.0.0:2222
# Host and port shown in SSH clone URLs (defaults: base URL host, SSH bind port).
TAUR_SSH_PUBLIC_HOST=packages.taur.weirdbrains.com
TAUR_SSH_PUBLIC_PORT=2222
# gRPC listen address (plaintext HTTP/2); remove to disable gRPC.
TAUR_GRPC_BIND=127.0.0.1:50051
# SMTP server (secret). Remove to write mail to $TAUR_HOME/outbox instead.
TAUR_SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender address for outgoing mail.
TAUR_MAIL_FROM="TAUR <noreply@taur.weirdbrains.com>"
# Comma-separated users granted site admin at startup (grant only, never revokes).
TAUR_ADMINS=alice,bob
# RPC requests per window for each TCP peer. 0 disables the limiter.
# The peer is the socket address; X-Forwarded-For is ignored.
TAUR_RPC_RATE_LIMIT=0
TAUR_RPC_RATE_WINDOW=60

# ---- taurctl ----
# Server URL (overrides the config file).
TAUR_SERVER=https://packages.taur.weirdbrains.com
# Config directory holding settings and the session token.
TAURCTL_CONFIG_DIR=/home/alice/.config/taurctl

# ---- development only ----
# Set to 1 when running tests to regenerate man pages in man/.
#TAUR_UPDATE_MAN=1
# Internal (set by the server for git hooks; never set by hand):
# TAUR_HOOK_BIN, TAUR_PUSHER.
